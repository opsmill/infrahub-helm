# Tracks the upstream source for the Grafana dashboards bundled into this chart.
# The dashboards themselves are NOT committed: scripts/sync-dashboards.sh fetches
# and adapts them from the ref below at packaging/release time. Bump `ref` here
# to pin a new upstream version; the chart's appVersion should match it.
repo: opsmill/infrahub
ref: infrahub-v1.9.3
path: development/grafana/provisioning/dashboards
files:
  - infrahub_monitoring.json
  - neo4j_monitoring.json
  - rabbitmq_instance_monitoring.json
  - container_resources.json
  - loki_monitoring.json
  - prefect_platform_overview.json
  - prefect_flow_run_overview.json
